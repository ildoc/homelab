---
tunnel: {{ gitlab_cloudflared_credentials.TunnelID }}
credentials-file: /etc/cloudflared/credentials.json
metrics: 0.0.0.0:2000

ingress:
  - hostname: {{ gitlab.domain }}
    service: http://gitlab:80
    originRequest:
      connectTimeout: 30s
{% if gitlab.pages_domain | default('') | length > 0 %}
  # Pages: Host header seleziona il vhost pages_nginx su :80 (stesso container).
  - hostname: {{ gitlab.pages_domain }}
    service: http://gitlab:80
    originRequest:
      connectTimeout: 30s
{% endif %}
  - service: http_status:404
