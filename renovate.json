{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Configurazione Renovate per aggiornamenti automatici di Docker, Helm, Terraform e altro",
  "extends": [
    "local>renovate/renovate-config",
    "docker:pinDigests"
  ],
  "separateMajorMinor": false,
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "**/archived/**",
    "docs/**"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "kubernetes/**/*.yaml",
      "kubernetes/**/*.yml"
    ]
  },
  "argocd": {
    "managerFilePatterns": [
      "kubernetes/root-applications.yaml",
      "kubernetes/groups/*.yaml",
      "kubernetes/infra/*.yaml"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "ansible/roles/**/templates/docker-compose.yaml.j2",
        "ansible/roles/**/templates/docker-compose.yml.j2"
      ],
      "matchStrings": [
        "(?:^|\\n)[ \\t]*image:[ \\t]*[\"']?(?<depName>[^\\s\"']+?):(?<currentValue>[^\\s@\"']+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\"']?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Tag Invidious basati su data con hash build",
      "matchPackageNames": [
        "quay.io/invidious/invidious",
        "quay.io/invidious/invidious-companion"
      ],
      "versioning": "regex:^(?<major>\\d{4})\\.(?<minor>\\d{1,2})\\.(?<patch>\\d{1,2})-[a-f0-9]+$"
    },
    {
      "description": "Aggiornamenti GitHub Actions",
      "matchDatasources": ["github-tags"],
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "Aggiornamenti Terraform/OpenTofu",
      "matchDatasources": ["terraform-provider", "terraform-module"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Una MR per dipendenza, sempre verso la versione più recente",
      "matchPackageNames": ["*"],
      "groupName": null
    },
    {
      "description": "GitLab: priorità alta e una MR per ogni minor (upgrade path obbligatori)",
      "matchPackageNames": ["gitlab/gitlab-ce"],
      "prPriority": 10,
      "separateMajorMinor": true,
      "separateMultipleMinor": true
    },
    {
      "description": "Pin e digest in un'unica MR con automerge",
      "matchUpdateTypes": ["pin", "pinDigest", "digest"],
      "groupName": "docker digests",
      "automerge": true
    }
  ]
}
